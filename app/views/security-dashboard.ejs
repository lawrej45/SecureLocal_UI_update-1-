<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Security Dashboard | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">AUDIT-BASED MONITORING</p><h1>Security dashboard</h1><p class="lead">Counts are derived from audit events and active account lockouts. Failed-login alert threshold: 10 in one hour.</p><p class="notice <%= metrics.alert?'bad':'good' %>"><strong><%= metrics.alert?'Alert: threshold reached':'No active alert' %></strong> · <%= metrics.failedLoginsLastHour %> failed logins in the last hour.</p><a class="button" href="/security/report">Download security report (JSON)</a></section><section class="grid three"><div class="stat" data-emoji="🔒"><strong><%= metrics.lockedAccounts %></strong><span>Currently locked accounts</span></div><div class="stat" data-emoji="🚫"><strong><%= metrics.deniedAccessLast24Hours %></strong><span>Denied-access events (24h)</span></div><div class="stat" data-emoji="⚠️"><strong><%= metrics.failedLoginsLastHour %></strong><span>Failed logins (1h)</span></div></section><section class="panel"><h2>Failed logins per day</h2><div class="table-wrap"><table><thead><tr><th>Date</th><th>Failed login events</th></tr></thead><tbody><% metrics.failedLoginsByDay.forEach(day=>{ %><tr><td><%= day.day %></td><td><%= day.count %></td></tr><% }) %></tbody></table></div><p class="muted small">Report generated <%= metrics.generatedAt %>. This dashboard does not display submitted passwords or authentication codes.</p></section></main></body></html>
