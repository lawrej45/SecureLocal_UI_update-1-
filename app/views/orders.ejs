<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Orders | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">ORDER MANAGEMENT</p><h1><%= isStaff?'All customer orders':'My orders' %></h1></section><% if(!orders.length){ %><section class="panel empty"><span class="big">📦</span><p>No orders found yet. <a href="/menu">Browse the menu</a> and treat yourself!</p></section><% } %><div class="grid two"><% const flow=['Pending','Confirmed','Preparing','Ready','Completed']; orders.forEach(o=>{ const at=flow.indexOf(o.status); %><article class="card ticket"><% if(['Completed','Cancelled','Ready'].includes(o.status)){ %><span class="stamp s-<%= String(o.status).toLowerCase() %>"><%= o.status %></span><% } %><div class="split"><h2>Order #<%= o.id %></h2><span class="pill s-<%= String(o.status).toLowerCase() %>"><%= o.status %></span></div><% if(o.status==='Cancelled'){ %><p class="muted small">This order was cancelled.</p><% } else { %><div class="tracker" aria-label="Order progress"><% flow.forEach((s,i)=>{ %><div class="step <%= i<at?'done':(i===at?'now':'') %>"><%= s %></div><% }) %></div><% } %><dl class="kv"><dt>Item</dt><dd><%= o.item_name||'Legacy order' %> × <%= o.quantity||1 %></dd><dt>Customer</dt><dd><%= o.customer_name %> (<%= o.username||user.username %>)</dd><dt>Total</dt><dd>₱<%= Number(o.total).toFixed(2) %></dd><dt>Contact</dt><dd><%= o.contact_number||'—' %></dd><dt>Address</dt><dd><%= o.address||'—' %></dd><dt>Notes</dt><dd><%= o.notes||'—' %></dd></dl><p class="muted small"><%= o.created_at %></p><% if(!isStaff && o.status==='Pending'){ %><form method="post" action="/orders/<%= o.id %>/cancel" data-confirm="Cancel this pending order?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button small-button secondary">Cancel pending order</button></form><% } %><% if(isStaff){ %><form class="inline-form" method="post" action="/orders/<%= o.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="status"><% ['Pending','Confirmed','Preparing','Ready','Completed','Cancelled'].forEach(s=>{ %><option value="<%= s %>" <%= s===o.status?'selected':'' %>><%= s %></option><% }) %></select><button class="button small-button">Update status</button></form><% } %></article><% }) %></div></main></body></html>