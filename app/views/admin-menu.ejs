<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Menu | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">MENU MANAGEMENT</p><h1>Manage pizza menu</h1></section><section class="panel"><h2>Add menu item</h2><form class="form grid-form" method="post" action="/admin/menu"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Name<input name="name" minlength="2" maxlength="100" required></label><label>Price (PHP)<input name="price" type="number" min="0" max="100000" step="0.01" required></label><label class="wide">Description<input name="description" maxlength="500"></label><button class="button">Add item</button></form></section><div class="table-wrap"><table><thead><tr><th>Item</th><th>Description</th><th>Price</th><th>Availability</th><th>Update / Actions</th></tr></thead><tbody><% menu.forEach(m=>{ %><tr><td><strong><%= m.name %></strong></td><td><%= m.description||'—' %></td><td>₱<%= Number(m.price).toFixed(2) %></td><td><%= m.available?'Available':'Hidden' %></td><td><form class="form" method="post" action="/admin/menu/<%= m.id %>/update"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input name="name" value="<%= m.name %>" maxlength="100" required><input name="description" value="<%= m.description||'' %>" maxlength="500"><input name="price" type="number" min="0" max="100000" step="0.01" value="<%= m.price %>" required><button class="button small-button">Save changes</button></form><div class="actions compact"><form method="post" action="/admin/menu/<%= m.id %>/availability"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="available" value="<%= m.available?0:1 %>"><button class="button small-button secondary"><%= m.available?'Hide':'Publish' %></button></form><form method="post" action="/admin/menu/<%= m.id %>/delete" data-confirm="Delete this menu item permanently?"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="button small-button danger">Delete</button></form></div></td></tr><% }) %></tbody></table></div></main></body></html>
