<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Privacy Requests | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">PRIVACY OPERATIONS</p><h1>Correction and deletion requests</h1><p class="lead">Review requests submitted by account holders. Record the action or reason in the response note.</p></section><% if(!requests.length){ %><section class="panel"><p>No privacy requests are waiting.</p></section><% } %><div class="grid two"><% requests.forEach(r=>{ %><article class="card"><div class="split"><h2><%= r.request_type %> request #<%= r.id %></h2><span class="pill"><%= r.status %></span></div><p><strong>Account:</strong> <%= r.username %> · <%= r.email %></p><p class="preserve"><%= r.details %></p><p class="muted small">Submitted <%= r.created_at %><%= r.processed_at?' · Processed '+r.processed_at:'' %></p><% if(r.resolution){ %><p><strong>Response:</strong> <%= r.resolution %></p><% } %><% if(r.status==='Pending'){ %><form class="form" method="post" action="/admin/data-requests/<%= r.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="In review"><button class="button small-button">Start review</button></form><% } else if(r.status==='In review'){ %><form class="form" method="post" action="/admin/data-requests/<%= r.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Resolution note<textarea name="resolution" maxlength="1000" rows="3"><%= r.resolution||'' %></textarea></label><div class="actions"><button class="button small-button" name="status" value="Completed">Mark completed</button><button class="button small-button danger" name="status" value="Rejected">Reject request</button></div></form><% } %></article><% }) %></div><p class="notice">Marking a request completed records that it was processed; carry out and document the correction or deletion described in the resolution note.</p></main></body></html>
