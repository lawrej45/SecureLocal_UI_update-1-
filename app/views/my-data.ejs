<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>My Data | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">DATA PRIVACY</p><h1>My Data</h1><p class="lead">Review, download, or ask the team to correct or delete your information.</p><a class="button" href="/mfa/my-data/export">Download my data (JSON)</a></section><% if(error){ %><p class="alert"><%= error %></p><% } %><section class="panel"><h2>Account details</h2><p><strong>Username:</strong> <%= user.username %></p><p><strong>Email:</strong> <%= user.email %></p><p><strong>Role:</strong> <%= user.role %></p><p><strong>MFA:</strong> <%= user.mfa_enabled?'Enabled':'Not enabled' %></p><p><strong>Privacy consent:</strong> <%= user.consent_accepted_at||'Not recorded' %></p><p><strong>Created:</strong> <%= user.created_at %></p></section><section class="panel"><h2>Orders</h2><% if(!orders.length){ %><p>No orders.</p><% } else { orders.forEach(o=>{ %><article class="card"><h3>Order #<%= o.id %> · <%= o.item_name||'Order' %> × <%= o.quantity||1 %></h3><p>Customer: <%= o.customer_name %> · ₱<%= Number(o.total).toFixed(2) %> · <%= o.status %> · <%= o.created_at %></p><p>Contact: <%= o.contact_number||'—' %> · Address: <%= o.address||'—' %></p><p>Notes: <%= o.notes||'—' %></p></article><% }) } %></section><section class="panel"><h2>Incident reports</h2><% if(!incidents.length){ %><p>No incident reports.</p><% } else { incidents.forEach(i=>{ %><article class="card"><p>Incident #<%= i.id %> · <%= i.category %> · <%= i.severity %> · <%= i.status %> · <%= i.created_at %></p><p class="preserve"><%= i.description %></p></article><% }) } %></section><section class="panel"><h2>Request a correction or deletion</h2><p class="muted">Requests are reviewed by an administrator. A request does not immediately change or delete records.</p><form class="form" method="post" action="/mfa/my-data/requests"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Request type<select name="request_type" required><option value="Correction">Correction</option><option value="Deletion">Deletion</option></select></label><label>What should we review?<textarea name="details" minlength="10" maxlength="1000" rows="4" required></textarea></label><button class="button">Submit request</button></form></section><section class="panel"><h2>My privacy requests</h2><% if(!dataRequests.length){ %><p>No requests submitted.</p><% } else { dataRequests.forEach(r=>{ %><article class="card"><div class="split"><h3><%= r.request_type %> request #<%= r.id %></h3><span class="pill"><%= r.status %></span></div><p class="preserve"><%= r.details %></p><p><strong>Admin response:</strong> <%= r.resolution||'Awaiting review' %></p><p class="muted small">Submitted <%= r.created_at %><%= r.processed_at?' · Processed '+r.processed_at:'' %></p></article><% }) } %></section></main></body></html>
