<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Audit Logs | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">ACCOUNTABILITY</p><h1>Security audit logs</h1><p class="lead">Latest <%= logs.length %> events. Logs do not store passwords, OTPs or backup codes.</p><p class="notice <%= integrity.valid?'good':'bad' %>">Audit hash-chain: <strong><%= integrity.valid?'Verified':'Integrity warning' %></strong> · <%= integrity.checked %> entries checked · <%= integrity.reason %></p></section><div class="table-wrap"><table><thead><tr><th>ID</th><th>Date/time</th><th>User ID</th><th>Event</th><th>Details</th><th>IP</th><th>Hash</th></tr></thead><tbody><% logs.forEach(log=>{ %><tr><td><%= log.id %></td><td><%= log.created_at %></td><td><%= log.user_id||'System' %></td><td><strong><%= log.action %></strong></td><td><%= log.details||'—' %></td><td><%= log.ip_address||'—' %></td><td class="hash"><%= log.entry_hash?log.entry_hash.slice(0,16)+'…':'Legacy' %></td></tr><% }) %></tbody></table></div><p class="muted small">Hash chaining helps detect edits to linked audit records, but it is not immutable against an attacker with full database access.</p></main></body></html>
