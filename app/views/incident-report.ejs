<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Report Incident | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="narrow"><section class="panel"><p class="eyebrow">SECURITY & PRIVACY</p><h1>Report an incident</h1><p class="muted">Do not include passwords, OTPs, backup codes or other secrets in your report.</p><% if(error){ %><p class="alert"><%= error %></p><% } %><form class="form" method="post" action="/incidents/report"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Category<select name="category"><option>Account security</option><option>Suspicious activity</option><option>Privacy concern</option><option>System issue</option><option>Other</option></select></label><label>Severity<select name="severity"><option>Low</option><option selected>Medium</option><option>High</option><option>Critical</option></select></label><label>Description<textarea name="description" minlength="10" maxlength="2000" rows="6" required></textarea></label><button class="button">Submit report</button></form></section></main></body></html>
