<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Pizza Menu | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">B'IZZA WOODFIRE PIZZA & CO.</p><h1>Pizza menu</h1><p class="lead">Fired fresh in our woodfire oven. Pick a pizza and place a test order.</p></section><section class="grid two"><% const emo=['🍕','🧀','🌶️','🍄','🌿','🍅']; menu.forEach((m,idx)=>{ %><article class="card pizza-card"><% if(idx===0){ %><span class="sticker">⭐ Chef's pick</span><% } %><div class="pizza-top"><div class="pizza-emoji"><%= emo[idx%emo.length] %></div><div><h2><%= m.name %></h2><p class="price">₱<%= Number(m.price).toFixed(2) %></p></div></div><p class="muted"><%= m.description||'' %></p><% if(user){ %><details class="order"><summary>🛒 Order this pizza</summary><form class="form" method="post" action="/orders" data-price="<%= Number(m.price) %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="menu_id" value="<%= m.id %>"><label>Your name<input name="customer_name" maxlength="100" required></label><label>Contact number<input name="contact_number" maxlength="30" required></label><label>Delivery address<input name="address" minlength="5" maxlength="500" required></label><label>Quantity<input name="quantity" type="number" min="1" max="20" value="1" required></label><label>Order notes (optional)<input name="notes" maxlength="500" placeholder="Extra crispy, no onions…"></label><div class="live-total"><span>Estimated total</span><b>₱<%= Number(m.price).toFixed(2) %></b></div><button class="button full">Place order 🔥</button><small>🔒 Contact number and address are encrypted before storage.</small></form></details><% } else { %><a class="button" href="/login">Log in to order</a><% } %></article><% }) %></section><% if(!menu.length){ %><section class="panel empty"><span class="big">🍕</span><p>No available menu items yet. Check back soon!</p></section><% } %></main></body></html>