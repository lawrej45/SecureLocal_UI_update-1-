<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify MFA | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user:currentUser,csrfToken}) %><main class="narrow"><section class="panel auth-panel"><p class="eyebrow">SECOND FACTOR</p><h1><%= stepUp?'Confirm it is you':'Verify your sign-in' %></h1><p>Enter the six-digit code from your authenticator app. You may use an unused backup code instead.</p><% if(error){ %><p class="alert"><%= error %></p><% } %><form class="form" method="post" action="<%= stepUp?'/mfa/step-up':'/mfa/verify' %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Authenticator or backup code<input name="code" autocomplete="one-time-code" maxlength="20" required></label><button class="button">Verify</button></form></section></main></body></html>
