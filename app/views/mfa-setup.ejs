<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Set up MFA | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user:currentUser,csrfToken}) %><main class="narrow"><section class="panel auth-panel"><p class="eyebrow">ACCOUNT SECURITY</p><h1>Set up authenticator MFA</h1><% if(required){ %><p class="alert">MFA must be enabled before you can use privileged administration features.</p><% } %><% if(error){ %><p class="alert"><%= error %></p><% } %><% if(backupCodes){ %><p class="success">MFA is enabled. Save these backup codes now. Each code can be used once.</p><div class="codes"><% backupCodes.forEach(c=>{ %><code><%= c %></code><% }) %></div><p class="muted">These codes are shown only once. Store them offline and do not share them.</p><a class="button" href="/dashboard">Return to dashboard</a><% } else { %><div class="steps"><span><b>1</b>Scan QR</span><span><b>2</b>Enter code</span><span><b>3</b>Save backup codes</span></div><p>1. Scan this QR code using an authenticator app, or manually enter the setup key.</p><% if(qr){ %><img class="qr" src="<%= qr %>" alt="Authenticator QR code"><% } %><p class="secret"><strong>Setup key:</strong> <code><%= secret %></code></p><form class="form" method="post" action="/mfa/setup"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>2. Enter the six-digit code from your app<input name="code" inputmode="numeric" pattern="[0-9]{6}" minlength="6" maxlength="6" required></label><button class="button">Verify and enable MFA</button></form><% } %></section></main></body></html>
