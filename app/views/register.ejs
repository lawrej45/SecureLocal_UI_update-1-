<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Register | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user:null,csrfToken}) %><main class="narrow"><section class="panel auth-panel"><p class="eyebrow">SECURELOCAL ACCOUNT</p><h1>Create customer account</h1><p class="muted">Public registration always creates a Customer account. Staff and admin roles are assigned by an authorized Owner.</p><% if(error){ %><p class="alert"><%= error %></p><% } %><form class="form" method="post" action="/auth/register"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Username</label><input name="username" minlength="3" maxlength="30" pattern="[A-Za-z0-9_]{3,30}" value="<%= username %>" autocomplete="username" required><label>Email</label><input type="email" name="email" maxlength="254" value="<%= email %>" autocomplete="email" required><label>Password</label><input type="password" name="password" minlength="12" maxlength="72" autocomplete="new-password" required><small>At least 12 characters, no username, avoid common passwords (bcrypt input max 72 UTF-8 bytes).</small><label class="check"><input type="checkbox" name="consent" value="yes" required> I have read and agree to the <a href="/privacy" target="_blank" rel="noopener">Privacy Notice</a>.</label><button class="button full">Create account</button></form><p class="switch">Already registered? <a href="/login">Log in</a></p></section></main></body></html>
