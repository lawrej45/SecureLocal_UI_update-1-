<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">ADMINISTRATION</p><h1>Administration</h1><p class="lead">Welcome, <%= user.username %>. Privileged actions require recent MFA verification.</p></section><section class="grid four"><div class="stat" data-emoji="👥"><strong><%= stats.users %></strong><span>Accounts</span></div><div class="stat" data-emoji="🍕"><strong><%= stats.orders %></strong><span>Orders</span></div><div class="stat" data-emoji="🚨"><strong><%= stats.openIncidents %></strong><span>Open incidents</span></div><div class="stat" data-emoji="🧾"><strong><%= stats.events %></strong><span>Audit events</span></div></section><section class="panel"><h2>Admin tools</h2><div class="actions"><a class="button" href="/admin/audit-logs">Audit logs</a><a class="button secondary" href="/admin/users">Manage user roles</a><a class="button secondary" href="/admin/menu">Manage pizza menu</a><a class="button secondary" href="/admin/data-requests">Privacy requests</a><a class="button secondary" href="/admin/backup">Download backup + checksum</a><a class="button secondary" href="/security">Security dashboard</a><a class="button secondary" href="/incidents">Review incidents</a><a class="button secondary" href="/orders">Manage orders</a></div></section><section class="panel"><h2>Recent security events</h2><% if(!recent.length){ %><p class="muted">No events recorded yet.</p><% } else { %><div class="table-wrap"><table><thead><tr><th>Event</th><th>Details</th><th>Time</th></tr></thead><tbody><% recent.forEach(r=>{ %><tr><td><strong><%= r.action %></strong></td><td><%= r.details||'—' %></td><td><%= r.created_at %></td></tr><% }) %></tbody></table></div><% } %></section></main></body></html>
