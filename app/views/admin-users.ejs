<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Manage Users | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">ADMIN CONTROLS</p><h1>User accounts and roles</h1><p class="lead">Admins can manage non-Owner roles. Owner accounts are protected, and public registration cannot create privileged accounts.</p></section><div class="table-wrap"><table><thead><tr><th>Username</th><th>Email</th><th>Role</th><th>MFA</th><th>Lock status</th><th>Created</th><th>Update role</th></tr></thead><tbody><% users.forEach(u=>{ %><tr><td><strong><%= u.username %></strong></td><td><%= u.email %></td><td><%= u.role %></td><td><%= u.mfa_enabled?'Enabled':'Not enabled' %></td><td><%= u.locked_until&&Date.parse(u.locked_until)>Date.now()?'Locked':'Normal' %></td><td><%= u.created_at %></td><td><% if(user.role==='Admin'&&u.role!=='Owner'){ %><form class="inline-form" method="post" action="/admin/users/<%= u.id %>/role"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><select name="role"><% ['Admin','Staff','Security Officer','Customer'].forEach(r=>{ %><option value="<%= r %>" <%= r===u.role?'selected':'' %>><%= r %></option><% }) %></select><button class="button small-button">Save</button></form><% } else { %><span class="muted"><%= u.role==='Owner'?'Protected Owner account':'No permission' %></span><% } %></td></tr><% }) %></tbody></table></div></main></body></html>
