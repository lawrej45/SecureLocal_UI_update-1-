<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Incidents | SecureLocal</title><meta name="theme-color" content="#c2410c"><link rel="icon" href="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 100 100%27%3E%3Ctext y=%27.9em%27 font-size=%2790%27%3E🍕%3C/text%3E%3C/svg%3E"><link rel="stylesheet" href="/css/style.css"><script src="/js/theme.js"></script><script src="/js/app.js" defer></script></head><body><%- include('partials/nav',{user,csrfToken}) %><main class="container"><section class="page-head"><p class="eyebrow">INCIDENT MANAGEMENT</p><h1><%= canReview?'Reported incidents':'My incident reports' %></h1><p class="lead"><%= canReview?'Security Officer and Admin responders advance incidents through the documented response workflow.':'Only your own incident reports are shown here.' %></p><div class="actions"><a class="button secondary" href="/incidents/report">🚨 New report</a></div></section><% if(!incidents.length){ %><section class="panel empty"><span class="big">🛡️</span><p>All quiet — no incident reports yet. <a href="/incidents/report">Submit a report</a> if something looks off.</p></section><% } %><div class="grid two"><% const workflow=['Reported','Investigating','Contained','Resolved','Lessons learned']; incidents.forEach(i=>{ const next=workflow[workflow.indexOf(i.status)+1]; %><article class="card"><div class="sev-bar" data-sev="<%= i.severity %>"></div><div class="split"><h2>Incident #<%= i.id %></h2><span class="pill"><%= i.status %></span></div><p><strong>Reporter:</strong> <%= i.username||user.username %></p><p><span class="pill sev-<%= String(i.severity).toLowerCase() %>"><%= i.severity %></span> <span class="muted small">· <%= i.category %></span></p><p class="preserve"><%= i.description %></p><p class="muted small"><%= i.created_at %></p><% if(canReview&&next){ %><form class="inline-form" method="post" action="/incidents/<%= i.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= next %>"><button class="button small-button">Move to <%= next %></button></form><% } %></article><% }) %></div></main></body></html>